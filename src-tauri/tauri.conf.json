{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortMate",
  "version": "0.1.17",
  "identifier": "dev.portmate.desktop",
  "build": {
    "beforeDevCommand": "npm run easytier:prepare && npm run shell-elevation:prepare && npm run dev",
    "beforeBuildCommand": "npm run easytier:prepare && npm run shell-elevation:prepare && npm run build && npm run sidecar:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNTUxOThFNDE2OEI1MjEKUldRaHRXaEJqaGxWUDB1YytSRFE1WGs2YTRqeUlmcEVKQ21PRXdlOUJua0o1RnNkUzc3Wjk2UDUK",
      "endpoints": [
        "https://github.com/YYH2913/PortMate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "PortMate",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PortMate Contributors",
    "category": "DeveloperTool",
    "shortDescription": "MCP-ready SSH, serial, and terminal workspace",
    "longDescription": "PortMate is a cross-platform terminal workspace for SSH, serial, Telnet, raw TCP, Tmux, file transfer, diagnostics, and local MCP session control.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES/JetBrainsMono-OFL.txt": "THIRD_PARTY_LICENSES/JetBrainsMono-OFL.txt",
      "../THIRD_PARTY_LICENSES/gsudo-MIT.txt": "THIRD_PARTY_LICENSES/gsudo-MIT.txt",
      "../licenses/EasyTier-NOTICE.txt": "THIRD_PARTY_LICENSES/EasyTier-NOTICE.txt",
      "../licenses/EasyTier-LGPL-3.0.txt": "THIRD_PARTY_LICENSES/EasyTier-LGPL-3.0.txt",
      "../licenses/GPL-3.0.txt": "THIRD_PARTY_LICENSES/GPL-3.0.txt",
      "../licenses/Wintun-LICENSE.txt": "THIRD_PARTY_LICENSES/Wintun-LICENSE.txt",
      "../licenses/WinDivert-LICENSE.txt": "THIRD_PARTY_LICENSES/WinDivert-LICENSE.txt",
      "../licenses/portable-pty-MIT.txt": "THIRD_PARTY_LICENSES/portable-pty-MIT.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
