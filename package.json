{
  "name": "portmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-node-version.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/ensure-node-version.mjs",
    "build": "tsc && vite build",
    "pretest": "node scripts/ensure-node-version.mjs",
    "test": "vitest run",
    "pretest:terminal-compat": "node scripts/ensure-node-version.mjs",
    "test:terminal-compat": "node scripts/terminal-compat-check.mjs",
    "pretest:vttest-compat": "node scripts/ensure-node-version.mjs",
    "test:vttest-compat": "node scripts/vttest-compat-check.mjs",
    "pretest:tmux-workflow": "node scripts/ensure-node-version.mjs",
    "test:tmux-workflow": "node scripts/tmux-workflow-check.mjs",
    "pretest:tmux-version-compat": "node scripts/ensure-node-version.mjs",
    "test:tmux-version-compat": "node scripts/tmux-version-compat-check.mjs",
    "pretest:workspace-ui": "node scripts/ensure-node-version.mjs",
    "test:workspace-ui": "node scripts/workspace-ui-check.mjs",
    "pretest:mcp-http-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-http-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-http-client-check.mjs",
    "pretest:mcp-stdio-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-stdio-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-stdio-client-check.mjs",
    "pretest:mcp-typescript-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-typescript-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-typescript-client-check.mjs",
    "pretest:mcp-python-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-python-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-python-client-check.mjs",
    "pretest:mcp-go-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-go-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-go-client-check.mjs",
    "pretest:mcp-rust-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-rust-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-rust-client-check.mjs",
    "pretest:mcp-ruby-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-ruby-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-ruby-client-check.mjs",
    "pretest:mcp-java-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-java-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-java-client-check.mjs",
    "pretest:mcp-kotlin-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-kotlin-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-kotlin-client-check.mjs",
    "pretest:mcp-csharp-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-csharp-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-csharp-client-check.mjs",
    "pretest:mcp-swift-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-swift-client": "cargo build --locked -p portmate-mcp && node scripts/mcp-swift-client-check.mjs",
    "pretest:mcp-sdk-freshness": "node scripts/ensure-node-version.mjs",
    "test:mcp-sdk-freshness": "node scripts/mcp-sdk-freshness.mjs",
    "pretest:native-keyring": "node scripts/ensure-node-version.mjs",
    "test:native-keyring": "node scripts/native-keyring-check.mjs",
    "pretest:dependency-audit": "node scripts/ensure-node-version.mjs",
    "test:dependency-audit": "npm audit --audit-level=moderate",
    "pretest:rust-dependency-audit": "node scripts/ensure-node-version.mjs",
    "test:rust-dependency-audit": "node scripts/rust-dependency-audit.mjs",
    "pretest:native-keyring-dependencies": "node scripts/ensure-node-version.mjs",
    "test:native-keyring-dependencies": "node scripts/native-keyring-dependency-check.mjs",
    "pretest:portable-vault": "node scripts/ensure-node-version.mjs",
    "test:portable-vault": "cargo test --locked -p portmate tests::portable_vault_tests::portable_vault_cross_process_fault_matrix -- --exact --nocapture --test-threads=1",
    "pretest:portable-cross": "node scripts/ensure-node-version.mjs",
    "test:portable-cross": "node scripts/portable-cross-check.mjs",
    "pretest:ssh-server-compat": "node scripts/ensure-node-version.mjs",
    "test:ssh-server-compat": "node scripts/ssh-server-compat-check.mjs",
    "test:libssh-gssapi-build": "bash scripts/libssh-gssapi-build-check.sh",
    "pretest:ssh-gssapi-compat": "node scripts/ensure-node-version.mjs",
    "test:ssh-gssapi-compat": "node scripts/ssh-gssapi-compat-check.mjs",
    "pretest:tcp-telnet-server-compat": "node scripts/ensure-node-version.mjs",
    "test:tcp-telnet-server-compat": "node scripts/tcp-telnet-server-compat-check.mjs",
    "pretest:linux-desktop-smoke": "node scripts/ensure-node-version.mjs",
    "test:linux-desktop-smoke": "node scripts/linux-desktop-smoke-check.mjs",
    "pretest:linux-appimage-smoke": "node scripts/ensure-node-version.mjs",
    "test:linux-appimage-smoke": "node scripts/linux-appimage-smoke-check.mjs",
    "pretest:linux-package": "node scripts/ensure-node-version.mjs",
    "test:linux-package": "node scripts/linux-package-check.mjs",
    "pretest:windows-package": "node scripts/ensure-node-version.mjs",
    "test:windows-package": "node scripts/windows-package-check.mjs",
    "pretest:macos-package": "node scripts/ensure-node-version.mjs",
    "test:macos-package": "node scripts/macos-package-check.mjs",
    "prepreview": "node scripts/ensure-node-version.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "pretauri": "node scripts/ensure-node-version.mjs",
    "tauri": "tauri",
    "predesktop": "node scripts/ensure-node-version.mjs",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:clean": "node scripts/desktop-clean.mjs",
    "predesktop:build": "node scripts/ensure-node-version.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "predesktop:build:windows-gnu": "node scripts/ensure-node-version.mjs",
    "desktop:build:windows-gnu": "node scripts/build-windows-portable.mjs",
    "presidecar:dev": "node scripts/ensure-node-version.mjs",
    "sidecar:dev": "node scripts/prepare-sidecar.mjs",
    "presidecar:build": "node scripts/ensure-node-version.mjs",
    "sidecar:build": "node scripts/prepare-sidecar.mjs --release",
    "preicon": "node scripts/ensure-node-version.mjs",
    "icon": "node scripts/generate-icon.mjs && tauri icon src-tauri/icons/icon.png --output src-tauri/icons"
  },
  "dependencies": {
    "@serialpilot/cobs": "^0.1.0",
    "@serialpilot/modbus-rtu": "^0.1.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "ipaddr.js": "1.9.1",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "slip": "^1.0.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/slip": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-spawn": "^7.0.6",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "undici": "7.29.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
