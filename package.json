{
  "name": "portmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:terminal-compat": "node scripts/terminal-compat-check.mjs",
    "test:tmux-workflow": "node scripts/tmux-workflow-check.mjs",
    "test:workspace-ui": "node scripts/workspace-ui-check.mjs",
    "test:mcp-http-client": "cargo build -p portmate-mcp && node scripts/mcp-http-client-check.mjs",
    "test:mcp-stdio-client": "cargo build -p portmate-mcp && node scripts/mcp-stdio-client-check.mjs",
    "test:linux-package": "node scripts/linux-package-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:clean": "node scripts/desktop-clean.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "sidecar:dev": "node scripts/prepare-sidecar.mjs",
    "sidecar:build": "node scripts/prepare-sidecar.mjs --release",
    "icon": "node scripts/generate-icon.mjs && tauri icon src-tauri/icons/icon.png --output src-tauri/icons"
  },
  "dependencies": {
    "@serialpilot/cobs": "^0.1.0",
    "@serialpilot/modbus-rtu": "^0.1.0",
    "@tauri-apps/api": "^2.10.1",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "slip": "^1.0.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/slip": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
