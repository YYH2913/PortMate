{
  "name": "portmate",
  "private": true,
  "packageManager": "npm@12.0.2",
  "version": "0.1.11",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-node-version.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/ensure-node-version.mjs",
    "build": "tsc && vite build",
    "pretest": "node scripts/ensure-node-version.mjs",
    "test": "tsc -p test/tsconfig.json && vitest run --config test/vitest.config.ts",
    "pretest:rustfmt": "node scripts/ensure-node-version.mjs",
    "test:rustfmt": "node test/tooling/rustfmt-check.mjs",
    "pretest:terminal-compat": "node scripts/ensure-node-version.mjs",
    "test:terminal-compat": "node test/tooling/terminal-compat-check.mjs",
    "pretest:vttest-compat": "node scripts/ensure-node-version.mjs",
    "test:vttest-compat": "node test/tooling/vttest-compat-check.mjs",
    "pretest:tmux-workflow": "node scripts/ensure-node-version.mjs",
    "test:tmux-workflow": "node test/tooling/tmux-workflow-check.mjs",
    "pretest:tmux-version-compat": "node scripts/ensure-node-version.mjs",
    "test:tmux-version-compat": "node test/tooling/tmux-version-compat-check.mjs",
    "pretest:workspace-ui": "node scripts/ensure-node-version.mjs",
    "test:workspace-ui": "node test/tooling/workspace-ui-check.mjs",
    "docs:screenshots": "node scripts/readme-screenshots.mjs",
    "pretest:mcp-http-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-http-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-http-client-check.mjs",
    "pretest:mcp-stdio-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-stdio-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-stdio-client-check.mjs",
    "pretest:mcp-typescript-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-typescript-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-typescript-client-check.mjs",
    "pretest:mcp-python-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-python-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-python-client-check.mjs",
    "pretest:mcp-go-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-go-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-go-client-check.mjs",
    "pretest:mcp-rust-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-rust-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-rust-client-check.mjs",
    "pretest:mcp-ruby-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-ruby-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-ruby-client-check.mjs",
    "pretest:mcp-java-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-java-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-java-client-check.mjs",
    "pretest:mcp-kotlin-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-kotlin-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-kotlin-client-check.mjs",
    "pretest:mcp-csharp-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-csharp-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-csharp-client-check.mjs",
    "pretest:mcp-swift-client": "node scripts/ensure-node-version.mjs",
    "test:mcp-swift-client": "cargo build --locked -p portmate-mcp && node test/tooling/mcp-swift-client-check.mjs",
    "pretest:mcp-sdk-freshness": "node scripts/ensure-node-version.mjs",
    "test:mcp-sdk-freshness": "node test/tooling/mcp-sdk-freshness.mjs",
    "pretest:native-keyring": "node scripts/ensure-node-version.mjs",
    "test:native-keyring": "node test/tooling/native-keyring-check.mjs",
    "pretest:dependency-audit": "node scripts/ensure-node-version.mjs",
    "test:dependency-audit": "node test/tooling/dependency-audit.mjs",
    "pretest:rust-dependency-audit": "node scripts/ensure-node-version.mjs",
    "test:rust-dependency-audit": "node test/tooling/rust-dependency-audit.mjs",
    "pretest:native-keyring-dependencies": "node scripts/ensure-node-version.mjs",
    "test:native-keyring-dependencies": "node test/tooling/native-keyring-dependency-check.mjs",
    "pretest:portable-vault": "node scripts/ensure-node-version.mjs",
    "test:portable-vault": "node test/tooling/native-rust-tests.mjs portable-vault",
    "pretest:portable-cross": "node scripts/ensure-node-version.mjs",
    "test:portable-cross": "node test/tooling/portable-cross-check.mjs",
    "pretest:release-source": "node scripts/ensure-node-version.mjs",
    "test:release-source": "node test/tooling/release-source-check.mjs",
    "pretest:release-upgrade": "node scripts/ensure-node-version.mjs",
    "test:release-upgrade": "node test/tooling/native-rust-tests.mjs release-upgrade && vitest run --config test/vitest.config.ts test/frontend/release-upgrade.test.ts",
    "pretest:ssh-server-compat": "node scripts/ensure-node-version.mjs",
    "test:ssh-server-compat": "node test/tooling/ssh-server-compat-check.mjs",
    "test:libssh-gssapi-build": "bash test/tooling/libssh-gssapi-build-check.sh",
    "pretest:ssh-gssapi-compat": "node scripts/ensure-node-version.mjs",
    "test:ssh-gssapi-compat": "node test/tooling/ssh-gssapi-compat-check.mjs",
    "pretest:tcp-telnet-server-compat": "node scripts/ensure-node-version.mjs",
    "test:tcp-telnet-server-compat": "node test/tooling/tcp-telnet-server-compat-check.mjs",
    "pretest:linux-desktop-smoke": "node scripts/ensure-node-version.mjs",
    "test:linux-desktop-smoke": "node test/tooling/linux-desktop-smoke-check.mjs",
    "pretest:linux-appimage-smoke": "node scripts/ensure-node-version.mjs",
    "test:linux-appimage-smoke": "node test/tooling/linux-appimage-smoke-check.mjs",
    "pretest:linux-package": "node scripts/ensure-node-version.mjs",
    "test:linux-package": "node test/tooling/linux-package-check.mjs",
    "pretest:windows-package": "node scripts/ensure-node-version.mjs",
    "test:windows-package": "node test/tooling/windows-package-check.mjs",
    "pretest:macos-package": "node scripts/ensure-node-version.mjs",
    "test:macos-package": "node test/tooling/macos-package-check.mjs",
    "prepreview": "node scripts/ensure-node-version.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "pretauri": "node scripts/ensure-node-version.mjs",
    "tauri": "tauri",
    "predesktop": "node scripts/ensure-node-version.mjs",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:clean": "node scripts/desktop-clean.mjs",
    "predesktop:build": "node scripts/ensure-node-version.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "predesktop:build:windows-gnu": "node scripts/ensure-node-version.mjs",
    "desktop:build:windows-gnu": "node scripts/build-windows-portable.mjs",
    "presidecar:dev": "node scripts/ensure-node-version.mjs",
    "sidecar:dev": "node scripts/prepare-sidecar.mjs",
    "presidecar:build": "node scripts/ensure-node-version.mjs",
    "sidecar:build": "node scripts/prepare-sidecar.mjs --release",
    "preicon": "node scripts/ensure-node-version.mjs",
    "icon": "node scripts/generate-icon.mjs && tauri icon src-tauri/icons/icon.png --output src-tauri/icons"
  },
  "dependencies": {
    "@serialpilot/cobs": "^0.1.0",
    "@serialpilot/modbus-rtu": "^0.1.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "slip": "^1.0.2"
  },
  "devDependencies": {
    "@babel/parser": "8.0.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/slip": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-spawn": "^7.0.6",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "undici": "8.10.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
